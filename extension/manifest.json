{
  "manifest_version": 3,
  "name": "Voice2Text",
  "version": "0.1.0",
  "description": "Live captions from your browser audio. Speech recognition runs on your Mac.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "tabCapture", "offscreen", "scripting", "storage", "nativeMessaging"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Voice2Text"},
  "options_page": "options.html",
  "web_accessible_resources": [{"resources": ["protocol.js"], "matches": ["http://*/*", "https://*/*"]}],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:8766 ws://127.0.0.1:8766"}
}
